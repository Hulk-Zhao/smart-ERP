{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://smart-erp.local/contracts/config.schema.json",
  "title": "smart-ERP 环境变量契约（C11）",
  "description": "唯一真源：compose 注入键 + .env.example 登记键 + 代码读取键。scope=compose/build/deploy/code；required=true 表示 compose 用 ${K:?} 强制；default 必须与 compose 的 ${K:-x} 一致。由 scripts/validate_config_schema.py 校验（含 compose 覆盖、默认值一致、多默认冲突、.env.example 与三套环境矩阵的类型/未知键、代码里读取但未登记的键）。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "ERP_DATABASE_URL",
    "ERP_IMAGE_TAG",
    "ERP_MIGRATION_DATABASE_URL"
  ],
  "properties": {
    "ERP_AGENT_WORKER_CONCURRENCY": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "worker-agent"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 4
    },
    "ERP_API_BIND": {
      "type": "string",
      "scope": "compose",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "127.0.0.1"
    },
    "ERP_API_PORT": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 8010
    },
    "ERP_API_ROOT_PATH": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "/erp/api"
    },
    "ERP_APP_ENV": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "compensation",
        "connector-gw",
        "doc",
        "migrate",
        "scheduler",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "demo"
    },
    "ERP_ASSISTANT_RATE_LIMIT_PER_MINUTE": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 10,
      "minimum": 1,
      "description": "助手建议每租户每分钟上限（单实例内存令牌桶），超限 429"
    },
    "ERP_AUDIT_ANCHOR": {
      "type": "string",
      "scope": "compose",
      "services": [
        "scheduler"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "1",
      "description": "1/true/yes/on 开启日切锚点（full 档默认），0/false/no/off 关闭（demo 档在 .env.demo 置 0）；非法值 scheduler 启动即失败"
    },
    "ERP_BUILD_PLATFORM": {
      "type": "string",
      "scope": "build",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "linux/amd64"
    },
    "ERP_BUILD_WEB_BASE": {
      "type": "string",
      "scope": "build",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "/demo/smart-erp/"
    },
    "ERP_COMPENSATION_PORT": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "compensation"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 8013,
      "description": "补偿执行器 /metrics 与 /healthz 监听端口；仅内网 expose，不发布宿主端口"
    },
    "ERP_COMPENSATION_POLL_SECONDS": {
      "type": "number",
      "scope": "compose",
      "services": [
        "compensation"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 1.0,
      "description": "常驻循环间隔（秒）；/healthz 按 max(30, poll*5) 判 stale"
    },
    "ERP_COMPENSATION_STALE_SECONDS": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "compensation"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 60,
      "description": "running 行重认领阈值，同时作为 compensation_overdue 指标阈值（秒）"
    },
    "ERP_CONFIG_DIR": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "compensation",
        "connector-gw",
        "doc",
        "migrate",
        "scheduler",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "/app/config"
    },
    "ERP_CONNECTOR_GW_HOST": {
      "type": "string",
      "scope": "code",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "0.0.0.0",
      "description": "连接器网关监听地址（gateway.py --host 缺省值）；固定为 0.0.0.0：compose 不下发本键，容器内始终走代码默认，修改无效"
    },
    "ERP_CONNECTOR_GW_PORT": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "connector-gw"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 8012
    },
    "ERP_CONNECTOR_GW_URL": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "scheduler",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "http://connector-gw:8012"
    },
    "ERP_DATABASE_URL": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "compensation",
        "scheduler",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": true,
      "secret": true,
      "phase": "startup",
      "default": "postgresql+asyncpg://erp_app:CHANGE_ME_PASSWORD@hulkai_aps_postgres:5432/smart_erp"
    },
    "ERP_DB_IDLE_TX_TIMEOUT_MS": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 60000
    },
    "ERP_DB_LOCK_TIMEOUT_MS": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 3000
    },
    "ERP_DB_MAX_OVERFLOW": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "api",
        "compensation",
        "scheduler",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "4",
      "defaultsByService": {
        "api": "0",
        "compensation": "0",
        "scheduler": "0",
        "worker": "0",
        "worker-agent": "0",
        "worker-io": "0"
      }
    },
    "ERP_DB_NETWORK": {
      "type": "string",
      "scope": "compose",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "hulkai-gz-api_default"
    },
    "ERP_DB_POOL_SIZE": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "api",
        "compensation",
        "scheduler",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "4",
      "defaultsByService": {
        "api": "4",
        "compensation": "2",
        "scheduler": "1",
        "worker": "4",
        "worker-agent": "4",
        "worker-io": "2"
      }
    },
    "ERP_DB_STATEMENT_TIMEOUT_MS": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 30000
    },
    "ERP_DEMO_SESSION_ENABLED": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "",
      "description": "1/true/yes/on 才绑定部署期注入的 demo 静态会话；默认关闭，且 ERP_APP_ENV 必须为 demo，否则启动失败（apps/api/demo_session.py）。只读当前会话，不签发令牌"
    },
    "ERP_DEMO_SESSION_ORGS": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "",
      "description": "demo 会话授权组织，逗号分隔（对应 G-05 org_id）"
    },
    "ERP_DEMO_SESSION_PERIODS": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "",
      "description": "demo 会话授权期间，逗号分隔（对应 G-05 period）"
    },
    "ERP_DEMO_SESSION_ROLES": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "",
      "description": "demo 会话角色，逗号分隔（如 reviewer,approver,cfo）；审批待办按它与发起人过滤"
    },
    "ERP_DEMO_SESSION_SYSTEMS": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "",
      "description": "demo 会话授权系统，逗号分隔（对应 G-05 system_ids）"
    },
    "ERP_DEMO_SESSION_TENANT_ID": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "",
      "description": "demo 会话租户 UUID；开启开关时必填"
    },
    "ERP_DEMO_SESSION_TOKEN": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": true,
      "phase": "startup",
      "default": "",
      "description": "部署期注入的静态会话令牌（至少 16 字符）；只从请求头 X-Session-Token 或 Authorization: Bearer 读取，不接受 query 参数"
    },
    "ERP_DEMO_SESSION_USER_ID": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "",
      "description": "demo 会话用户 UUID；开启开关时必填"
    },
    "ERP_DEPLOY_DIR": {
      "type": "string",
      "scope": "deploy",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "/opt/smart-erp"
    },
    "ERP_DEPLOY_HOST": {
      "type": "string",
      "scope": "deploy",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": null
    },
    "ERP_DEPLOY_SSH_PORT": {
      "type": "integer",
      "scope": "deploy",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 22
    },
    "ERP_DEPLOY_USER": {
      "type": "string",
      "scope": "deploy",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": null
    },
    "ERP_DIST_DIR": {
      "type": "string",
      "scope": "build",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": null
    },
    "ERP_DOC_PORT": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "doc"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 8020
    },
    "ERP_DOC_SERVICE_URL": {
      "type": "string",
      "scope": "compose",
      "services": [
        "worker-io"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "http://doc:8020"
    },
    "ERP_FILE_INBOX": {
      "type": "string",
      "scope": "compose",
      "services": ["connector-gw"],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "",
      "description": "文件通道收件箱目录；留空=不挂载 file 连接器，显式设置但目录不存在/不可读时 connector-gw 启动失败（apps/connectors/gateway.py）"
    },
    "ERP_GATEWAY_PORT": {
      "type": "string",
      "scope": "code",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "8012",
      "description": "ERP_CONNECTOR_GW_PORT 的兼容别名，两者都缺省 8012；仅在 ERP_CONNECTOR_GW_PORT 缺失时读取，compose 永远先设后者，修改通常无效"
    },
    "ERP_GW_EGRESS_ALLOWLIST_FILE": {
      "type": "string",
      "scope": "compose",
      "services": [
        "connector-gw"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "/app/config/gw-egress.yaml"
    },
    "ERP_GW_TIMEOUT_SECONDS": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "connector-gw"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 30
    },
    "ERP_HEARTBEAT_INTERVAL_SECONDS": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "scheduler",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 30
    },
    "ERP_IMAGE_TAG": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "compensation",
        "connector-gw",
        "doc",
        "migrate",
        "scheduler",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": true,
      "secret": false,
      "phase": "startup",
      "default": null,
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{40}-dirty|dev)$"
    },
    "ERP_IO_WORKER_CONCURRENCY": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "worker-io"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 2
    },
    "ERP_LLM_API_KEY": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "worker",
        "worker-agent"
      ],
      "required": false,
      "secret": true,
      "phase": "startup",
      "default": ""
    },
    "ERP_LLM_BASE_URL": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "worker",
        "worker-agent"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": ""
    },
    "ERP_LLM_MODEL": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "worker",
        "worker-agent"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": ""
    },
    "ERP_LLM_PROVIDER": {
      "type": "string",
      "scope": "code",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "cloud",
      "description": "预留：当前全仓无读取点（LLM 客户端尚未实现），设置了不生效"
    },
    "ERP_LLM_TEMPERATURE": {
      "type": "integer",
      "scope": "code",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 0,
      "description": "预留：当前全仓无读取点（LLM 客户端尚未实现），设置了不生效"
    },
    "ERP_LLM_TIMEOUT_SECONDS": {
      "type": "integer",
      "scope": "compose",
      "services": [
        "api",
        "worker",
        "worker-agent"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": 60
    },
    "ERP_LOG_LEVEL": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "compensation",
        "connector-gw",
        "doc",
        "migrate",
        "scheduler",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": false,
      "secret": false,
      "phase": "hot",
      "default": "INFO",
      "enum": [
        "DEBUG",
        "INFO",
        "WARNING",
        "ERROR"
      ]
    },
    "ERP_METERING_CAP_AMOUNT": {
      "type": "string",
      "scope": "code",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": null,
      "description": "封顶金额，未配置时封顶余额不可核对"
    },
    "ERP_METERING_CURRENCY": {
      "type": "string",
      "scope": "code",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "CNY",
      "description": "计量币种（三位大写 ISO 代码，如 CNY）"
    },
    "ERP_METERING_PRIOR_AMOUNT": {
      "type": "string",
      "scope": "code",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": null,
      "description": "历史已计金额，未配置按 0"
    },
    "ERP_METERING_REQUIRE_CONTRACT_PRICE": {
      "type": "string",
      "scope": "code",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": null,
      "description": "true 时禁止回落到 ERP_METERING_UNIT_PRICE：无生效合同价返回 503 E-PRICE-MISSING，有价但币种不符返回 503 E-PRICE-CURRENCY"
    },
    "ERP_METERING_UNIT_LABEL": {
      "type": "string",
      "scope": "code",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "行",
      "description": "计量单位显示名"
    },
    "ERP_METERING_UNIT_PRICE": {
      "type": "string",
      "scope": "code",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": null,
      "description": "单行单价，必须来自配置；未配置时计量接口返回 503"
    },
    "ERP_MIGRATION_DATABASE_URL": {
      "type": "string",
      "scope": "compose",
      "services": [
        "migrate"
      ],
      "required": true,
