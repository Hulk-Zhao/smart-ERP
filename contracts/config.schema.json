      "phase": "startup",
      "default": "postgresql+asyncpg://erp_migrator:CHANGE_ME_PASSWORD@hulkai_aps_postgres:5432/smart_erp"
    },
    "ERP_NGINX_IMAGE": {
      "type": "string",
      "scope": "build",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": null
    },
    "ERP_OBJECT_STORE_DRIVER": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "doc",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "local"
    },
    "ERP_OBJECT_STORE_PATH": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "doc",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": "/data/objects"
    },
    "ERP_ROLLBACK_SYNC_ENABLED": {
      "type": "string",
      "scope": "code",
      "services": [],
      "required": false,
      "secret": false,
      "phase": "startup",
      "default": null,
      "description": "true 才开放 POST /tickets/{id}/actions/compensate 的同步回滚（默认 false）：关闭时返回 503 E-ROLLBACK-UNAVAILABLE 且连接器零调用。该路径仍不写 ticket_event、仍有无痕窗口，仅作过渡，不得对外承诺"
    },
    "ERP_S3_ACCESS_KEY": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "doc",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": false,
      "secret": true,
      "phase": "startup",
      "default": ""
    },
    "ERP_S3_BUCKET": {
      "type": "string",
      "scope": "compose",
      "services": [
        "api",
        "doc",
        "worker",
        "worker-agent",
        "worker-io"
      ],
      "required": false,
      "secret": false,
      "phase": "startup",
