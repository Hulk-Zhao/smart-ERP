{
  "contract": "ticket-state-machine",
  "states": [
    "计划中",
    "待确认",
    "待审批",
    "执行中",
    "校验中",
    "已完成",
    "补偿中",
    "已回滚",
    "需人工处置",
    "已锁定",
    "已终止",
    "已驳回"
  ],
  "step_states": [
    "intent",
    "running",
    "succeeded",
    "failed",
    "skipped",
    "compensating",
    "compensated",
    "unresolved"
  ],
  "terminal_states": [
    "已完成",
    "已回滚",
    "需人工处置",
    "已锁定",
    "已终止",
    "已驳回"
  ],
  "transitions": [
    {
      "from": "待审批",
      "to": "已终止"
    },
    {
      "from": "待审批",
      "to": "已驳回"
    },
    {
      "from": "待审批",
      "to": "执行中"
    },
    {
      "from": "待确认",
      "to": "已终止"
    },
    {
      "from": "待确认",
      "to": "待审批"
    },
    {
      "from": "执行中",
      "to": "已锁定"
    },
    {
      "from": "执行中",
      "to": "校验中"
    },
    {
      "from": "执行中",
      "to": "补偿中"
    },
    {
      "from": "校验中",
      "to": "已完成"
    },
    {
      "from": "校验中",
      "to": "补偿中"
    },
    {
      "from": "补偿中",
      "to": "已回滚"
    },
    {
      "from": "补偿中",
      "to": "需人工处置"
    },
    {
      "from": "计划中",
      "to": "已终止"
    },
    {
      "from": "计划中",
      "to": "待审批"
    },
    {
      "from": "计划中",
      "to": "待确认"
    }
  ],
  "version": "1.0"
}
