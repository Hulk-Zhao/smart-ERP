# =============================================================================
# 演示档一体化环境（demo profile）——模板，不含任何真实密钥
# -----------------------------------------------------------------------------
# 用法：
#   cp deploy/smart-erp/.env.demo deploy/smart-erp/.env     # 由 scripts/demo-up.sh 自动完成
#   docker compose --project-directory deploy/smart-erp --profile demo up -d
#
# 与 .env.example 的关系：.env.example 是全档位「唯一真源」清单；本文件是
# 「demo 档可直接起」的最小可用取值，含 demo 静态会话。改动本文件前先确认
# .env.example 已登记同名键（C11）。
#
# 两个口令占位符由 scripts/demo-up.sh 在生成 .env 时分别替换：
#   CHANGE_ME_APP_PASSWORD -> DEMO_APP_PASSWORD（erp_app）
#   CHANGE_ME_MIG_PASSWORD -> DEMO_MIG_PASSWORD（erp_migrator，与 db/00-provision.sql 一致）
# 手工使用时请自行替换为真实口令，不要把真实口令提交回本文件。
# =============================================================================

# ---- 1. 镜像与发布 ----------------------------------------------------------
# 40 位 git sha；本次验收构建自 origin/main 5ef1df9（#110 已合入）。
# 重新构建后替换为新的完整 sha，禁止写 latest / 短 sha。
ERP_IMAGE_TAG=5ef1df9a263b45c028134d02e44f25d2c3125da3
ERP_APP_ENV=demo
ERP_LOG_LEVEL=INFO

# ---- 2. 数据库（官方 postgres:15，不需要 pgvector） ------------------------
# 主机名 = scripts/demo-up.sh 起的 PG 容器名（同一 docker 网络内解析）。
ERP_DATABASE_URL=postgresql+asyncpg://erp_app:CHANGE_ME_APP_PASSWORD@s8-demo-pg:5432/smart_erp
ERP_MIGRATION_DATABASE_URL=postgresql+asyncpg://erp_migrator:CHANGE_ME_MIG_PASSWORD@s8-demo-pg:5432/smart_erp
ERP_DB_NETWORK=s8-demo-db-net
ERP_DB_POOL_SIZE=4
ERP_DB_MAX_OVERFLOW=4
ERP_DB_STATEMENT_TIMEOUT_MS=30000
ERP_DB_LOCK_TIMEOUT_MS=3000
ERP_DB_IDLE_TX_TIMEOUT_MS=60000

# ---- 3. 端口 ---------------------------------------------------------------
ERP_API_BIND=127.0.0.1
ERP_API_PORT=8010
ERP_WEB_PORT=8088
ERP_API_ROOT_PATH=/erp/api
ERP_CONNECTOR_GW_PORT=8012
ERP_CONNECTOR_GW_URL=http://connector-gw:8012
ERP_DOC_PORT=8020

# ---- 4. 运行期基础项 -------------------------------------------------------
ERP_CONFIG_DIR=/app/config
ERP_WORKER_QUEUES=agent,io
ERP_WORKER_CONCURRENCY=4
ERP_HEARTBEAT_INTERVAL_SECONDS=30
ERP_SCHEDULER_TICK_SECONDS=60
# 演示档不写日切锚点：锚点是生产侧的链固化，演示时只产生与演示无关的行和告警噪声。
# full 档不设此键（compose 默认 1，即开启）。
ERP_AUDIT_ANCHOR=0
ERP_GW_TIMEOUT_SECONDS=30
ERP_GW_EGRESS_ALLOWLIST_FILE=/app/config/gw-egress.yaml
# demo 有演示价值（供应商对账单 CSV 导入）；scripts/demo-up.sh 会预建 inbox 目录
ERP_FILE_INBOX=/data/inbox

# ---- 5. 对象存储 -----------------------------------------------------------
ERP_OBJECT_STORE_DRIVER=local
ERP_OBJECT_STORE_PATH=/data/objects
ERP_S3_ENDPOINT=
ERP_S3_BUCKET=
ERP_S3_ACCESS_KEY=
ERP_S3_SECRET_KEY=

# ---- 6. 模型（不配置也能起；LLM 场景不可用） -------------------------------
ERP_LLM_BASE_URL=
ERP_LLM_API_KEY=
ERP_LLM_MODEL=
ERP_LLM_TIMEOUT_SECONDS=60

# ---- 7. demo 静态会话（7 个键全部必填，令牌 ≥16 字符） ---------------------
# 令牌只在部署期注入；API 不提供签发端点。请求只认 X-Session-Token / Bearer。
# 身份取种子数据里的「审批人」UUID（不是工单发起人 aaaaaaaa-...），
# 否则 /v1/approvals/pending 会按「发起人不得审批自己」把待办全部过滤掉。
ERP_DEMO_SESSION_ENABLED=true
ERP_DEMO_SESSION_TOKEN=demo-session-token-2026-11-11
ERP_DEMO_SESSION_USER_ID=dddddddd-dddd-4ddd-8ddd-dddddddddddd
ERP_DEMO_SESSION_TENANT_ID=a927f664-796d-5a6c-bb43-c052cd4a0e2e
ERP_DEMO_SESSION_ROLES=reviewer,approver,cfo
ERP_DEMO_SESSION_ORGS=ORG-SZ
# manufacturing-multi-plant 的三个对账批次分别在 2026-07/08/09；工单都在 2026-09
ERP_DEMO_SESSION_PERIODS=2026-07,2026-08,2026-09
ERP_DEMO_SESSION_SYSTEMS=u8,wms,sap

# ---- 8. 计量（demo 可选：种子带 price_book，不配单价也能按合同价出账） -----
ERP_METERING_UNIT_PRICE=
ERP_METERING_CURRENCY=CNY
ERP_METERING_UNIT_LABEL=行

# ---- 9. 可观测性（默认关闭；开启前先限定内网） -----------------------------
ERP_METRICS_ENABLED=
ERP_METRICS_PATH=/metrics
