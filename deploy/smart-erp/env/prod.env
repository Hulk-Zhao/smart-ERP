# 生产（prod）：`--profile full`；api 只绑 127.0.0.1，公网只能经香港 nginx 的 /erp/api/。
# 这是「实际取值」证据，不是模板；模板见 ../.env.example。
# 真实密钥（数据库密码、S3、LLM）只从密管注入，本文件只记录键名与形态。
ERP_IMAGE_TAG=e1926cf6748fe0fa31b432a9df221419dc086c8c
ERP_APP_ENV=full
ERP_LOG_LEVEL=INFO

ERP_DATABASE_URL=postgresql+asyncpg://erp_app:CHANGE_ME@hulkai_aps_postgres:5432/smart_erp
ERP_MIGRATION_DATABASE_URL=postgresql+asyncpg://erp_migrator:CHANGE_ME@hulkai_aps_postgres:5432/smart_erp
ERP_DB_NETWORK=hulkai-gz-api_default
ERP_DB_POOL_SIZE=8
ERP_DB_MAX_OVERFLOW=4
ERP_DB_STATEMENT_TIMEOUT_MS=30000
ERP_DB_LOCK_TIMEOUT_MS=3000
ERP_DB_IDLE_TX_TIMEOUT_MS=60000

# 生产红线：只绑回环，禁止 0.0.0.0
ERP_API_BIND=127.0.0.1
ERP_API_PORT=8010
ERP_WEB_PORT=8088
ERP_API_ROOT_PATH=/erp/api
ERP_CONNECTOR_GW_URL=http://connector-gw:8012
ERP_CONNECTOR_GW_HOST=0.0.0.0
ERP_GATEWAY_PORT=8012
ERP_CONNECTOR_GW_PORT=8012
ERP_DOC_PORT=8020
ERP_DOC_SERVICE_URL=http://doc:8020
ERP_CONFIG_DIR=/app/config

ERP_WORKER_QUEUES=agent
ERP_WORKER_CONCURRENCY=4
ERP_AGENT_WORKER_CONCURRENCY=4
ERP_IO_WORKER_CONCURRENCY=2
ERP_HEARTBEAT_INTERVAL_SECONDS=30
ERP_SCHEDULER_TICK_SECONDS=60
ERP_GW_TIMEOUT_SECONDS=30
ERP_GW_EGRESS_ALLOWLIST_FILE=/app/config/gw-egress.yaml

# full 档对象存储走 minio（Object Lock / WORM）；真实凭据由密管注入
ERP_OBJECT_STORE_DRIVER=minio
ERP_OBJECT_STORE_PATH=/data/objects
ERP_S3_ENDPOINT=http://minio.internal:9000
ERP_S3_BUCKET=smart-erp
ERP_S3_ACCESS_KEY=CHANGE_ME
ERP_S3_SECRET_KEY=CHANGE_ME
ERP_S3_REGION=cn-south-1

ERP_U8_BASE_URL=http://u8.internal:8080
# 文件通道收件箱：full/prod **默认关闭**（空值）；卷已由 compose 只读挂到 /data/inbox。
# 需要开启时填 /data/inbox，并确认宿主部署目录下 inbox 属主为 10001、权限 0750；
# 显式设置但目录不存在/不可读时 connector-gw 启动失败（不静默降级）。
ERP_FILE_INBOX=
ERP_METERING_UNIT_PRICE=0.20
ERP_METERING_CURRENCY=CNY
ERP_METERING_UNIT_LABEL=行
ERP_METERING_CAP_AMOUNT=100000
ERP_METERING_PRIOR_AMOUNT=0
