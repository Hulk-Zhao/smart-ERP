# 本地开发机（local）：单人、单机、demo 档；不对公网开放。
# 这是「实际取值」证据，不是模板；模板见 ../.env.example。
ERP_IMAGE_TAG=dev
ERP_APP_ENV=local
ERP_LOG_LEVEL=DEBUG

ERP_DATABASE_URL=postgresql+asyncpg://erp_app:erp_app@127.0.0.1:5432/smart_erp
ERP_MIGRATION_DATABASE_URL=postgresql+asyncpg://erp_migrator:erp_migrator@127.0.0.1:5432/smart_erp
ERP_DB_NETWORK=smart-erp-dev_default
ERP_DB_POOL_SIZE=2
ERP_DB_MAX_OVERFLOW=0
ERP_DB_STATEMENT_TIMEOUT_MS=30000

ERP_API_BIND=127.0.0.1
ERP_API_PORT=8010
ERP_WEB_PORT=8088
ERP_API_ROOT_PATH=/erp/api
ERP_CONNECTOR_GW_URL=http://connector-gw:8012
ERP_CONNECTOR_GW_HOST=0.0.0.0
ERP_GATEWAY_PORT=8012
ERP_CONNECTOR_GW_PORT=8012
ERP_DOC_PORT=8020
ERP_DOC_SERVICE_URL=http://doc:8020
ERP_CONFIG_DIR=/app/config

ERP_WORKER_QUEUES=agent,io
ERP_WORKER_CONCURRENCY=2
ERP_AGENT_WORKER_CONCURRENCY=2
ERP_IO_WORKER_CONCURRENCY=1
ERP_HEARTBEAT_INTERVAL_SECONDS=30
ERP_SCHEDULER_TICK_SECONDS=60
ERP_GW_TIMEOUT_SECONDS=30
ERP_GW_EGRESS_ALLOWLIST_FILE=/app/config/gw-egress.yaml

ERP_OBJECT_STORE_DRIVER=local
ERP_OBJECT_STORE_PATH=/data/objects

ERP_U8_BASE_URL=http://127.0.0.1:9090
# 文件通道收件箱：local 档默认留空 = 不启用（仅联调时按需开启）。
# 显式设置后目录必须存在且可读，否则 connector-gw 启动即失败（不静默降级）；
# 启用时 connector-gw 需以只读卷挂载该目录（./inbox:/data/inbox:ro）。
ERP_FILE_INBOX=
ERP_METERING_UNIT_PRICE=0.05
ERP_METERING_CURRENCY=CNY
ERP_METERING_UNIT_LABEL=行
