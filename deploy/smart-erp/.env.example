# =============================================================================
# 聚合型 AI ERP · 环境变量清单（demo 精简档 / 档位 1）
# -----------------------------------------------------------------------------
# 契约：C11 环境变量与配置契约（docs/product/tech/02-并发开发路线.md §1.2）
#   1. 本文件是**唯一真源**：compose 里出现的每个 ERP_* 变量都必须在此登记。
#   2. 本文件不含任何真实密钥。`cp .env.example .env` 后由部署人填写，.env 不入库
#      （.gitignore 已屏蔽 .env / .env.*，仅放行 .env.example）。
#   3. 标注「必填」的项留空或不写 → `docker compose config` 直接失败并指出变量名，
#      不允许「起一半再崩」。
#   4. 标「启动期只读」的项改动后需重建容器；标「可热更」的项由配置中心在运行期重载。
#
# 共用 PG15 的库/角色由实例 owner 一次性执行 deploy/smart-erp/db/00-provision.sql 建好：
#   database=smart_erp  schema=erp  role=erp_app(CONNECTION LIMIT 20) / erp_migrator
#   search_path、statement_timeout(30s)、lock_timeout(3s)、
#   idle_in_transaction_session_timeout(60s) 均写在该 role 上，故连接串不需要再带。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 镜像与发布（C12）
# -----------------------------------------------------------------------------
# 必填：完整 40 位 git sha，禁止 latest 承担发布语义。
#   build-images.sh 会把同名 tar 包打成 erp-images-<sha>.tar.gz；
#   回滚 = ERP_IMAGE_TAG=<上一 sha> docker compose up -d（镜像仍在本机）。
# 例：ERP_IMAGE_TAG=3f2b1c9de8a04b6f5c7d1e2a9b8c0d4e6f1a2b3c
ERP_IMAGE_TAG=

# 构建期参数（仅 scripts/build-images.sh 读取，容器内不需要）
ERP_BUILD_PLATFORM=linux/amd64
ERP_BUILD_WEB_BASE=/demo/smart-erp/

# -----------------------------------------------------------------------------
# 2. 数据库（共用 PG15，C14）
# -----------------------------------------------------------------------------
# 必填：指向共用实例的 smart_erp 库、erp_app 角色。
#   主机名取 APS 容器名 hulkai_aps_postgres（与 erp-db-net 同网）；换成 IP/域名亦可。
#   demo 档无 PITR，RPO=24h（每日 pg_dump -n erp）。
#   CHANGE_ME_PASSWORD 必须替换为 erp_app 的真实口令，禁止把真实口令写回本文件。
ERP_DATABASE_URL=postgresql+asyncpg://erp_app:CHANGE_ME_PASSWORD@hulkai_aps_postgres:5432/smart_erp

# full 档专用：一次性 migrate 服务用迁移角色（DDL 权限只在 erp_migrator 上，
# provision.sql 已限 CONNECTION LIMIT 4）。demo 档不使用该变量。
ERP_MIGRATION_DATABASE_URL=postgresql+asyncpg://erp_migrator:CHANGE_ME_PASSWORD@hulkai_aps_postgres:5432/smart_erp

# 兼容 01 §1A.7.4 的「连接串兜底」写法（asyncpg 用 server_settings 传 search_path）
# ERP_DATABASE_URL=postgresql+asyncpg://erp_app:CHANGE_ME_PASSWORD@hulkai_aps_postgres:5432/smart_erp?server_settings=search_path%3Derp

# 连接池预算（C14）：api 4+0 / worker 4+0 / scheduler 1+0，合计 9 ≤ erp_app 的 20 连接
# api 的 overflow 必须是 0：单进程内多个引擎共用 erp_app 的 20 连接上限，
# 实测并发 30 时各池一起扩容会打满上限（150 次请求里 42 次 500）。
# 多副本部署要按 erp_app 连接上限重新核算，不要直接放开。
ERP_DB_POOL_SIZE=4
ERP_DB_MAX_OVERFLOW=0
# 与角色级设置保持一致（provision.sql 已 ALTER ROLE）；这里下发是兜底，键名对齐 config.py
ERP_DB_STATEMENT_TIMEOUT_MS=30000
ERP_DB_LOCK_TIMEOUT_MS=3000
ERP_DB_IDLE_TX_TIMEOUT_MS=60000

# 外部网络名：共用 PG 所在网络（APS 栈默认网络）。网络不存在时 up 会直接报错。
ERP_DB_NETWORK=hulkai-gz-api_default

# -----------------------------------------------------------------------------
# 3. 端口（申请制；分配口径见 docs/product/tech/01-技术架构.md §1A.4）
# -----------------------------------------------------------------------------
# 8010 只绑回环（默认 127.0.0.1），公网入口只有 hk-web 的 nginx；
# 演示机确需宿主直连再改 ERP_API_BIND=0.0.0.0（并确认安全组限源）
ERP_API_BIND=127.0.0.1
ERP_API_PORT=8010
# 8088 → 容器 8080，仅香港反代
ERP_WEB_PORT=8088
# 8011 没有任何生效配置项：worker/scheduler 只跑 `tools.health <role> --check` 进程级探针，
# 没有常驻进程监听 8011（docparse 实际监听 8020），相关空键已删除，勿再加回。
# 8012 是连接器网关，仅 expose 不发布。
# 连接器网关监听端口：必须与 compose 里 gw 的 expose: "8012" 保持一致
ERP_CONNECTOR_GW_PORT=8012
# full 档 doc 服务监听端口：必须与 compose 里 doc 的 expose: "8020" 保持一致
ERP_DOC_PORT=8020

# -----------------------------------------------------------------------------
# 4. 运行期基础项
# -----------------------------------------------------------------------------
ERP_APP_ENV=demo
ERP_LOG_LEVEL=INFO
# 非密配置快照目录（场景/阈值/映射/出网白名单），随仓库版本管理，只读挂载
ERP_CONFIG_DIR=/app/config
# 后端对外根路径：香港 Nginx 用 /erp/api/ 前缀转发（§1A.4）
ERP_API_ROOT_PATH=/erp/api
ERP_CONNECTOR_GW_URL=http://connector-gw:8012

# worker：demo 档 agent 与 io 队列合并在一个容器（full 档拆 worker-io）
ERP_WORKER_QUEUES=agent,io
ERP_WORKER_CONCURRENCY=4
# full 档拆分后的并发：worker-agent / worker-io 各自独立
ERP_AGENT_WORKER_CONCURRENCY=4
ERP_IO_WORKER_CONCURRENCY=2
ERP_HEARTBEAT_INTERVAL_SECONDS=30
ERP_SCHEDULER_TICK_SECONDS=60
# 日切锚点：1/true/yes/on 开启（full 档默认），0/false/no/off 关闭；
# demo 档在 .env.demo 里置 0，演示环境不写 anchor 行。非法值会让 scheduler 启动即失败。
ERP_AUDIT_ANCHOR=1

# full 档：补偿执行器（apps.agents.compensation_worker）
#   PORT 只在内网 expose，不发布宿主；POLL 为常驻循环间隔；
#   STALE 同时用作 running 行的重认领阈值与 overdue 指标阈值（秒）。
ERP_COMPENSATION_PORT=8013
ERP_COMPENSATION_POLL_SECONDS=1.0
ERP_COMPENSATION_STALE_SECONDS=60

# full 档：io worker 调用 doc 解析服务的内网地址
ERP_DOC_SERVICE_URL=http://doc:8020

# 连接器网关
ERP_GW_TIMEOUT_SECONDS=30
ERP_GW_EGRESS_ALLOWLIST_FILE=/app/config/gw-egress.yaml
# 文件通道收件箱（connector-gw 只读挂载；demo 档默认 /data/inbox，full/prod 留空即不启用）
#   显式设置但目录不存在/不可读 = connector-gw 启动失败，不静默少挂一个连接器。
ERP_FILE_INBOX=

# -----------------------------------------------------------------------------
# 5. 对象存储（C8）
# -----------------------------------------------------------------------------
# demo：local（LocalObjectStore，落 erp_objects 卷，写入生成 sha256 清单，无存储层 WORM）
# full ：minio（Object Lock / WORM），需填下方 ERP_S3_*
ERP_OBJECT_STORE_DRIVER=local
ERP_OBJECT_STORE_PATH=/data/objects
# full 档才需要；demo 留空
ERP_S3_ENDPOINT=
ERP_S3_BUCKET=
ERP_S3_ACCESS_KEY=
ERP_S3_SECRET_KEY=
# 预留：当前全仓无读取点，设置了不生效。
ERP_S3_REGION=cn-south-1

# -----------------------------------------------------------------------------
# 6. 模型（LLM）
# -----------------------------------------------------------------------------
# demo 走云端 OpenAI 兼容接口（与 hulkai 一致）；ERP_LLM_API_KEY 为空时
# 依赖 LLM 的场景不可用，但进程与 /healthz 不受影响（探针不得触发业务写）。
ERP_LLM_BASE_URL=
ERP_LLM_API_KEY=
ERP_LLM_MODEL=
ERP_LLM_TIMEOUT_SECONDS=60
# 助手建议（/v1/assistant/suggest）每租户每分钟上限；单实例内存令牌桶，超限 429。
ERP_ASSISTANT_RATE_LIMIT_PER_MINUTE=10
# 预留：当前全仓无读取点（LLM 客户端尚未实现），设置了不生效。
ERP_LLM_TEMPERATURE=0
# 预留：当前全仓无读取点（LLM 客户端尚未实现），设置了不生效。
ERP_LLM_PROVIDER=cloud

# -----------------------------------------------------------------------------
# 7. 发布用（只被 scripts/deploy-images.sh / build-images.sh 读取，不进容器）
# -----------------------------------------------------------------------------
ERP_DEPLOY_HOST=
ERP_DEPLOY_USER=
ERP_DEPLOY_SSH_PORT=22
# 服务器上的部署目录（需已放好 docker-compose.yml 与本 .env）
ERP_DEPLOY_DIR=/opt/smart-erp

# -----------------------------------------------------------------------------
# 8. 只被应用代码读取的键（不进 compose；缺省即代码内默认值）
# -----------------------------------------------------------------------------
# 固定为 0.0.0.0，修改无效：compose 不下发本键，容器内始终走代码默认值；
# 网关必须绑 0.0.0.0 才能被栈内 api/worker 调用，改宿主 .env 不会进容器。
ERP_CONNECTOR_GW_HOST=0.0.0.0
# 由 compose 固定，修改通常无效：仅在 ERP_CONNECTOR_GW_PORT 缺失时读取，
# 而 compose 永远先设 ERP_CONNECTOR_GW_PORT（:-8012）。
ERP_GATEWAY_PORT=8012
# U8 连接器基地址（apps/connectors/u8/factory.py 缺省 http://u8.invalid 占位）。
# compose 里 api 缺省指向栈内 u8-stub（demo 档的**模拟外部系统**，不是真 U8）；
# 本文件保持占位域名：full/生产必须显式改成真实地址，别把写入打到桩上。
ERP_U8_BASE_URL=http://u8.invalid
# 计量策略（apps/api/metering.py）：单价必须来自配置，未配置时计量接口返回 503
ERP_METERING_UNIT_PRICE=
ERP_METERING_CURRENCY=CNY
ERP_METERING_UNIT_LABEL=行
ERP_METERING_CAP_AMOUNT=
ERP_METERING_PRIOR_AMOUNT=
# true 时禁止回落到 ERP_METERING_UNIT_PRICE：无生效合同价返回
# 503 E-PRICE-MISSING，有价但币种不符返回 503 E-PRICE-CURRENCY（apps/api/price_book.py）
ERP_METERING_REQUIRE_CONTRACT_PRICE=

# 同步回滚入口（apps/api/rollback_gate.py）：默认关闭。
# 注意：该键 scope=code，**不随 compose 下发**——只写在本文件不会生效；
# 要打开必须在 docker-compose.yml 的 api 服务 environment: 里显式加
#   ERP_ROLLBACK_SYNC_ENABLED: ${ERP_ROLLBACK_SYNC_ENABLED:-}
# 未设置/false 时 POST /v1/tickets/{id}/actions/compensate 返回
# 503 E-ROLLBACK-UNAVAILABLE，连接器零调用、工单状态不变。
# 打开后仍走旧的同步回写路径：不写 ticket_event、无租约/重试，
# 外部写与审计影像之间存在无痕窗口，仅作过渡，不得对外承诺。
ERP_ROLLBACK_SYNC_ENABLED=

# demo 静态会话（apps/api/demo_session.py）：默认关闭，只在 ERP_APP_ENV=demo 时允许打开。
# 打开后 api 启动日志会打印一行「DEMO SESSION ENABLED」醒目提示；full/生产档位
# 若设置 ERP_DEMO_SESSION_ENABLED=true 会直接拒绝启动（ConfigError）。
# 令牌只在部署期注入本文件/编排，**API 不提供任何签发端点**；请求只认
# X-Session-Token（或 Authorization: Bearer），query 参数一律不读。
# 开启时 7 个值都必须非空，否则启动失败；TOKEN 至少 16 个字符。
# GET /v1/auth/session 用它换回 {user_id, tenant_id, roles}，前端不再靠
# VITE_SESSION_ROLES / VITE_VIEWER_ID 猜身份。
ERP_DEMO_SESSION_ENABLED=
ERP_DEMO_SESSION_TOKEN=
ERP_DEMO_SESSION_USER_ID=
ERP_DEMO_SESSION_TENANT_ID=
ERP_DEMO_SESSION_ROLES=reviewer,approver,cfo
ERP_DEMO_SESSION_ORGS=ORG-1
ERP_DEMO_SESSION_PERIODS=2026-10
ERP_DEMO_SESSION_SYSTEMS=u8,statement

# -----------------------------------------------------------------------------
# 9. 可观测性（observability/ 读取；开启后必须先由反向代理限定内网）
# -----------------------------------------------------------------------------
# 当前未接线：解析已支持（1/true/yes/on 视为开启），但 exporter 零调用方，改了不生效。
ERP_TRACE_ENABLED=
# 当前未接线：路径解析已支持，但 exporter 零调用方，改了不生效。
ERP_TRACE_FILE=./logs/traces.jsonl
# 指标：留空 = compose 默认 true（api 与 scheduler 各自 serve /metrics，仅内网）
# 关掉会让对应进程承载的规则永远 absent；/metrics 不得直接暴露公网（见 RUNBOOK 5.2）
ERP_METRICS_ENABLED=
ERP_METRICS_PATH=/metrics
# scheduler 独立 /metrics 端口（Prometheus → scheduler:8011，仅内网 expose）
ERP_METRICS_PORT=8011
