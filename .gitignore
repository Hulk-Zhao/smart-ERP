# ============================================================
# 本地保留、不进版本库的内容
# 约定：调研 / AI 开发相关文档只在本地维护；`docs/product/` 自 2026-11-11 起纳入版本库
# ============================================================

# --- 文档（本地维护） ---
docs/research/
docs/ai/
docs/planning/
docs/drafts/
docs/notes/

# --- docs/product 内的单独排除（不整体忽略） ---
# 时间戳快照是「docs/product 无版本控制」时期留下的副本。入库后 git 历史本身就是快照，
# 再保留这 28 个文件（约 1.3MB）只是重复留档，且会让人分不清哪份是当前状态。
docs/product/tech/.snapshots/

# --- AI / Agent 开发痕迹 ---
.agent/
.agents/
.trae/
agent-logs/
agent_logs/
agent-runs/
experiments/
playground/
sandbox/
prompts/output/
prompts_output/
prompt_outputs/

# Jupyter 实验 notebook 与检查点（如需入库请用 ! 显式放行）
*.ipynb
.ipynb_checkpoints/

# --- 临时产物与本地草稿 ---
tmp/
temp/
scratch/
.cache/
*.tmp
*.temp
*.bak
*.orig
*.log
*.out

# --- 环境变量与密钥 ---
.env
.env.*
!.env.example
# demo 档一体化模板（不含真实密钥，口令为 CHANGE_ME 占位符）
!.env.demo
*.pem
*.key

# --- 语言运行时 / 依赖（按需保留） ---
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
*.tsbuildinfo

# --- 构建产物（不入库；防止任何 worktree 里一次 git add -A 带进仓库） ---
dist/
web/dist/
*.egg-info/

# --- 锁文件（既定策略：uv.lock 不入库） ---
uv.lock

# --- 根目录本地时间戳快照（与本仓库文档无关的本地产物） ---
/20[0-9][0-9]-[0-9][0-9]-[0-9][0-9]/

# --- 操作系统 / 编辑器 ---
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.swp
