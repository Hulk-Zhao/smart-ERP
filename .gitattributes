# 统一换行：仓库内与检出后一律 LF，避免 Windows 下的 CRLF 转换与警告
* text=auto eol=lf

# 明确文本类型，避免平台差异导致的换行噪音
*.md text
*.txt text
*.json text
*.yml text
*.yaml text
*.toml text
*.ini text
*.cfg text
*.py text
*.js text
*.ts text
*.tsx text
*.jsx text
*.html text
*.css text
*.scss text
*.sql text
*.sh text
*.ps1 text
.gitignore text
.gitattributes text

# 演示数据：CRLF 变体必须原样入库（否则 * text=auto 会把它归一成 LF，
# 「CRLF 也能解析」的演示文件就失去意义）
fixtures/recon/upload_demo/*_crlf.csv -text

# 二进制文件不做换行转换
*.png binary*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.xlsx binary
*.docx binary
*.pptx binary
