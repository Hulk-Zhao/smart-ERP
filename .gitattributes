# 统一换行：仓库内一律存为 LF，检出时按平台自动处理
* text=auto

# 明确文本类型，避免平台差异导致的换行噪音
*.md text
*.txt text
*.json text
*.yml text
*.yaml text
*.toml text
*.ini text
*.cfg text
*.py text
*.js text
*.ts text
*.tsx text
*.jsx text
*.html text
*.css text
*.scss text
*.sql text
*.sh text
*.ps1 text
.gitignore text
.gitattributes text

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.pdf binary
*.zip binary
*.gz binary
*.woff binary
*.woff2 binary
*.ttf binary
*.xlsx binary
*.docx binary
*.pptx binary
